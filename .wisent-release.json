{
  "schema_version": 1,
  "product": "openenv-kant",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?P<version>\\d+\\.\\d+\\.\\d+)\"\\s*$"
  },
  "platforms": {
    "linux-amd64": {
      "runner_platform": "linux-amd64",
      "quality": [
        {"name": "fmt", "argv": ["cargo", "fmt", "--all", "--", "--check"]}
      ],
      "build": {
        "argv": ["cargo", "build", "--release", "--locked", "--target-dir", "target"]
      },
      "tests": [
        {"name": "kant", "argv": ["cargo", "test", "--release", "--locked", "--target-dir", "target"]}
      ],
      "stage": {
        "target/release/kant": "bin/kant"
      }
    }
  },
  "promotion": {
    "channels": [
      "stable"
    ],
    "reconcile": false
  },
  "inputs": {},
  "deliveries": []
}
